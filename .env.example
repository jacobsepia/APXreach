# Neon Postgres — Reach's own database, separate from Ledger's.
DATABASE_URL=postgresql://user:password@host/reach?sslmode=require

# Better Auth. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Production only. Leave unset locally and on previews so Better Auth infers
# the origin per request — pinning it makes a preview reject its own sign-in.
BETTER_AUTH_URL=https://apxreach.vercel.app

# The APX Ledger OAuth client. Registered on Ledger's side with:
#   npx tsx scripts/register-oauth-client.mts apx-reach "APX Reach" \
#     https://apxreach.vercel.app/api/integrations/apxledger/callback \
#     http://localhost:3000/api/integrations/apxledger/callback
# The script prints the secret once; only its hash is stored by Ledger.
APXLEDGER_CLIENT_ID=apx-reach
APXLEDGER_CLIENT_SECRET=
# Must be the host that ANSWERS, never one that redirects. apxledger.ca is a
# 308 to www.apxledger.ca, and a redirect across hosts strips the Authorization
# header, so every credential Reach sends vanishes in flight and Ledger answers
# 401 as if the secret were wrong. Defaults to https://www.apxledger.ca.
# Point at a local Ledger while developing, e.g. http://localhost:3000
# APXLEDGER_BASE_URL=https://www.apxledger.ca

# ── Mailboxes ────────────────────────────────────────────────────────────
# A person connects their own mailbox so mail leaves from the address their
# clients recognise. Each provider's button only appears once BOTH of its
# variables are set, so a half-configured provider is never offered.

# Zoho: register at api-console.zoho.com, redirect
#   https://apxreach.vercel.app/api/mailboxes/zoho/callback
# Zoho accounts live in ONE data centre and a token is not portable between
# them; set these if the account is not on the .com one.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_MAIL_API_URL=https://mail.zoho.com

# Google: console.cloud.google.com, redirect
#   https://apxreach.vercel.app/api/mailboxes/google/callback
# Sending only for now. gmail.send is a "sensitive" scope — Google reviews the
# app, free. READING mail (gmail.readonly) is "restricted" and needs a CASA
# Tier 2 assessment by an approved lab, repeated every 12 months, on the order
# of a thousand dollars a year. The read scope is commented out in
# src/lib/mailbox/providers.ts until that clears.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: entra.microsoft.com app registration, redirect
#   https://apxreach.vercel.app/api/mailboxes/microsoft/callback
# Delegated permissions Mail.Read, Mail.Send, User.Read, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# The scheduled sync in vercel.json. Vercel sends this as a bearer token on
# every cron invocation; /api/cron/sync refuses when it is unset, so leaving it
# blank disables the schedule rather than opening the endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=
